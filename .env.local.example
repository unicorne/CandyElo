# Supabase (CandyElo project)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_…
SUPABASE_SECRET_KEY=sb_secret_…

# HMAC secret for pair tokens (32+ random chars)
PAIR_TOKEN_SECRET=

# Pepper for IP hashing (16+ random chars)
IP_HASH_PEPPER=

# Cloudflare Turnstile (skipped in dev when blank)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (in-memory fallback in dev when blank)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
